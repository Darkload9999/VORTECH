# VORTECH backend configuration for running on the host against the
# compose PostgreSQL (`make db-up`). Copy to .env (`make env`) and adjust.
# .env is git-ignored. Never commit real secrets.

# --- Runtime ------------------------------------------------------------
# development | test | staging | production
APP_ENV=development
LOG_LEVEL=info
# json | text (production requires json; development defaults to text)
LOG_FORMAT=text

# --- HTTP API -----------------------------------------------------------
HTTP_ADDR=127.0.0.1:8080
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_READ_TIMEOUT=15s
HTTP_WRITE_TIMEOUT=30s
HTTP_IDLE_TIMEOUT=120s
# Per-request context deadline; must not exceed HTTP_WRITE_TIMEOUT.
HTTP_REQUEST_TIMEOUT=20s
HTTP_MAX_BODY_BYTES=1048576
# Comma-separated IPs/CIDRs of reverse proxies whose X-Forwarded-For is
# trusted (OpenResty / K3s pod network). Empty = trust none.
HTTP_TRUSTED_PROXIES=

# --- Worker -------------------------------------------------------------
# Internal probe listener; never expose publicly.
WORKER_HTTP_ADDR=127.0.0.1:8081

# --- Shutdown -----------------------------------------------------------
# Keep serving (while not-ready) so load balancers deregister first.
# Use ~5s behind OpenResty/K3s; 0 locally.
SHUTDOWN_DRAIN_DELAY=0s
SHUTDOWN_TIMEOUT=25s

# --- PostgreSQL ---------------------------------------------------------
# Compose defaults (deployments/local/compose.yaml). Dev-only credentials.
POSTGRES_PASSWORD=vortech_dev_only
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgres://vortech:vortech_dev_only@127.0.0.1:55432/vortech?sslmode=disable
DATABASE_MAX_CONNS=20
DATABASE_MIN_CONNS=2
DATABASE_MAX_CONN_LIFETIME=1h
DATABASE_MAX_CONN_IDLE_TIME=30m
DATABASE_CONNECT_TIMEOUT=5s
DATABASE_STARTUP_TIMEOUT=30s
DATABASE_STATEMENT_TIMEOUT=15s
# Apply migrations at startup. Defaults to true in development/test and
# false elsewhere (production runs `migrate up` as a separate job).
DATABASE_AUTO_MIGRATE=true

# --- Keycloak (OIDC) ----------------------------------------------------
# Public base URL (including /auth); determines the expected token issuer
# http://localhost:8180/auth/realms/vortech. Must be https in production.
KEYCLOAK_URL=http://localhost:8180/auth
# Optional base URL for server-to-server calls (JWKS), e.g. in-cluster.
KEYCLOAK_INTERNAL_URL=
KEYCLOAK_REALM=vortech
# Frontend public client; tokens must be issued to it (azp).
KEYCLOAK_CLIENT_ID=vortech-web
# Must be present in the token audience (added by an audience mapper).
KEYCLOAK_AUDIENCE=vortech-api
AUTH_CLOCK_SKEW=30s
AUTH_JWKS_REFRESH_INTERVAL=15m
# Bounds how long a sub->user mapping and account status are cached.
AUTH_IDENTITY_CACHE_TTL=2m
# Compose Keycloak (dev-only placeholders).
KEYCLOAK_HOST_PORT=8180
KEYCLOAK_DB_PASSWORD=keycloak_dev_only
KEYCLOAK_ADMIN_PASSWORD=admin_dev_only

# --- Readiness ----------------------------------------------------------
READINESS_CHECK_TIMEOUT=2s
READINESS_CACHE_TTL=1s

# --- Compose stack (make compose-up) ------------------------------------
API_HOST_PORT=8080

# --- Later phases (not read yet) ----------------------------------------
